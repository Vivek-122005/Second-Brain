{
  "name": "@second-brain/server",
  "version": "0.0.0",
  "private": true,
  "description": "Cloudflare Worker: MCP server, REST API, auth, webhooks and scheduled jobs.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/ensure-assets.mjs && wrangler dev",
    "build": "node scripts/ensure-assets.mjs && wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval:search": "vitest run test/search-eval.test.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@second-brain/core": "workspace:*",
    "@second-brain/db": "workspace:*",
    "@second-brain/schema": "workspace:*",
    "@simplewebauthn/server": "^14.0.3",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.6",
    "@cloudflare/workers-types": "^5.20261021.1",
    "@second-brain/config": "workspace:*",
    "wrangler": "^4.151.3"
  }
}
