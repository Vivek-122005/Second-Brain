{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "second-brain",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // The web app (apps/web) is built to ../web/dist and served by this Worker.
  // API, MCP and webhook routes run the Worker first; everything else is the SPA.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/mcp",
      "/mcp/*",
      "/oauth/*",
      "/webhooks/*",
      "/health",
      "/.well-known/*",
    ],
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "second-brain-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],

  // Optional semantic layer (ADR-0004): Workers AI embeddings + a Vectorize index (768-d, cosine),
  // bound in every deployed environment below (`ai`, `vectorize`). Neither has a local emulator,
  // so local dev deliberately leaves them out: search runs keyword-only and reports
  // `semantic: "unavailable"`, and no Cloudflare account is needed. Create each index once per
  // environment (docs/runbooks/deploy.md).

  // Nightly full index rebuild, embedding catch-up and hygiene (HLD §4.4).
  "triggers": { "crons": ["17 3 * * *"] },

  "vars": {
    "ENVIRONMENT": "development",
    "SIGNUP_MODE": "allowlist",
    "ALLOWED_EMAILS": "",
    "APP_ORIGINS": "http://localhost:8787,http://localhost:5173",
    "EMAIL_FROM": "Second Brain <login@example.com>",
  },

  "env": {
    "staging": {
      "name": "second-brain-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "SIGNUP_MODE": "allowlist",
        "ALLOWED_EMAILS": "",
        "APP_ORIGINS": "",
        "EMAIL_FROM": "Second Brain <login@example.com>",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "second-brain-staging",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "../../packages/db/migrations",
        },
      ],
      "ai": { "binding": "AI" },
      "vectorize": [{ "binding": "VECTORIZE", "index_name": "second-brain-staging" }],
      "triggers": { "crons": ["17 3 * * *"] },
    },
    "production": {
      "name": "second-brain-production",
      "vars": {
        "ENVIRONMENT": "production",
        "SIGNUP_MODE": "allowlist",
        "ALLOWED_EMAILS": "",
        "APP_ORIGINS": "",
        "EMAIL_FROM": "Second Brain <login@example.com>",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "second-brain-production",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "../../packages/db/migrations",
        },
      ],
      "ai": { "binding": "AI" },
      "vectorize": [{ "binding": "VECTORIZE", "index_name": "second-brain-production" }],
      "triggers": { "crons": ["17 3 * * *"] },
    },
  },
}
